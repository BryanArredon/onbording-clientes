<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes><![CDATA[
            Dependencias de test (Testcontainers/JUnit) no se despliegan en produccion: no son
            explotables en tiempo de ejecucion.
        ]]></notes>
        <packageUrl regex=".*:(org\.testcontainers|junit|junit-jupiter|org\.junit|org\.junit\.platform|org\.junit\.jupiter|org\.assertj|org\.mockito|net\.bytebuddy|org\.objenesis|org\.apiguardian|org\.opentest4j|org\.hamcrest|org\.slf4j:slf4j-api).*"/>
        <packageUrl regex=".*:org\.springframework\.boot:spring-boot-starter-test.*"/>
    </suppress>
</suppressions>
